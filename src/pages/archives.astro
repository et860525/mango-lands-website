---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
const sortedPosts = posts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="所有文章 | Mango Lands">
    <div class="archives-container">
        <h1>所有文章</h1>

        <div class="timeline">
            {sortedPosts.map((post, index) => {
                const currentYear = post.data.date.getFullYear();
                const prevYear = sortedPosts[index - 1]?.data.date.getFullYear();
                // 如果是第一篇文章，或是年份與上一篇不同，就顯示年份標題
                const showYear = currentYear !== prevYear;

                return (
                    <>
                        {showYear && <div class="timeline-year">{currentYear}</div>}
                        <a href={`/posts/${post.slug}`} class="timeline-item">
                            <span class="date">{post.data.date.toISOString().slice(5, 10)}</span>
                            <span class="title">{post.data.title}</span>
                        </a>
                    </>
                );
            })}
        </div>
    </div>

    <style>
        .archives-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }

        h1 {
            text-align: center;
            margin-bottom: 3rem;
        }

        .timeline {
            position: relative;
            padding-left: 2rem;
            border-left: 2px solid rgba(255, 255, 255, 0.1);
            margin-left: 1rem;
        }

        .timeline-year {
            position: relative;
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--accent);
            margin: 2.5rem 0 1rem 0;
            line-height: 1;
        }

        .timeline-year::before {
            content: '';
            position: absolute;
            left: -2rem; /* 對齊左側邊線 (padding-left: 2rem) */
            top: 50%;
            transform: translate(-50%, -50%);
            width: 14px;
            height: 14px;
            background-color: var(--accent);
            border-radius: 50%;
            border: 4px solid #15171a; /* 假設背景色，製造間隔感 */
        }

        .timeline-item {
            display: flex;
            align-items: baseline;
            text-decoration: none;
            color: var(--fg);
            padding: 0.5rem 0;
            margin-bottom: 0.5rem;
            position: relative;
            transition: transform 0.2s ease;
        }

        .timeline-item:hover {
            transform: translateX(10px);
            color: var(--accent);
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -2rem; /* 對齊左側邊線 */
            top: 0.9rem;
            transform: translateX(-50%);
            width: 8px;
            height: 8px;
            background-color: var(--muted);
            border-radius: 50%;
            transition: background-color 0.2s;
        }

        .timeline-item:hover::before {
            background-color: var(--accent);
        }

        .date {
            font-family: "JetBrains Mono", monospace;
            color: var(--muted);
            margin-right: 1.5rem;
            font-size: 0.9rem;
            min-width: 50px;
        }

        .title {
            font-size: 1.1rem;
        }
    </style>
</BaseLayout>