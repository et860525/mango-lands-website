---
import "../styles/global.css";
import avatar from "../assets/avatars-rmback.png";
const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="icon" type="image/png" href={avatar.src} />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<nav>
			<div class="nav-inner">
				<a href="/">首頁</a>
				<a href="/about">關於我</a>
				<a href="/tags">標籤</a>
			</div>
		</nav>
		<main>
			<slot />
		</main>
		<footer class="page-footer">
			<p>&copy; {new Date().getFullYear()} Mango Lands. All rights reserved.</p>
		</footer>

		<style>
			.page-footer {
				text-align: center;
				padding-bottom: 1rem;
				color: var(--muted);
				font-size: 0.9rem;
			}
		</style>
	</body>
</html>
